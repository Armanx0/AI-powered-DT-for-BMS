# ============================================
# Battery Digital Twin MVP - Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ============================================
# FASTAPI APPLICATION
# ============================================
APP_NAME=Battery-Twin-MVP
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production
LOG_LEVEL=INFO

# ============================================
# DATABASE (Neon PostgreSQL - Free 3GB)
# ============================================
# Get from: https://neon.tech
# Format: postgresql://user:password@host/dbname
DATABASE_URL=postgresql://user:password@ep-xxxxx.neon.tech/battery_twin
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=False

# ============================================
# JWT AUTHENTICATION
# ============================================
SECRET_KEY=your-super-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRY=3600

# ============================================
# REDIS (Optional - for Celery background tasks)
# ============================================
# Leave empty to disable Redis
REDIS_URL=redis://localhost:6379/0
USE_REDIS=False

# ============================================
# CELERY (Optional - background task processing)
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
USE_CELERY=False

# ============================================
# ML MODELS PATH
# ============================================
MODELS_PATH=./app/models/ml

# ============================================
# AWS S3 (Optional - for model & data storage)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=battery-twin-models
AWS_REGION=us-east-1
USE_S3=False

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ============================================
# API CONFIGURATION
# ============================================
API_PORT=8000
API_HOST=0.0.0.0
API_WORKERS=4

# ============================================
# MONITORING & LOGGING
# ============================================
SENTRY_DSN=
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ============================================
# FEATURE ENGINEERING PARAMETERS
# ============================================
FEATURE_SMOOTHING_WINDOW=5
FEATURE_NORMALIZATION=true
FEATURE_SCALING_METHOD=standard

# ============================================
# MODEL INFERENCE PARAMETERS
# ============================================
SOC_MODEL_NAME=soc_model.pkl
SOH_MODEL_NAME=soh_model.pkl
FORECAST_MODEL_NAME=forecast_model.pkl
MODEL_INFERENCE_TIMEOUT=5000

# ============================================
# ANOMALY DETECTION THRESHOLDS
# ============================================
ANOMALY_SOH_THRESHOLD=0.8
ANOMALY_RESISTANCE_THRESHOLD=1.5
ANOMALY_VOLTAGE_RANGE=3.0
ANOMALY_TEMPERATURE_RANGE=60

# ============================================
# FORECASTING PARAMETERS
# ============================================
FORECAST_HORIZON_HOURS=24
FORECAST_STEP_SIZE=1
FORECAST_CONFIDENCE_INTERVAL=0.95

# ============================================
# DATABASE MIGRATION
# ============================================
ALEMBIC_SQLALCHEMY_URL=${DATABASE_URL}

# ============================================
# ENVIRONMENT-SPECIFIC FLAGS
# ============================================
SKIP_DATABASE_VALIDATION=False
ENABLE_MOCK_MODELS=False
ENABLE_DEBUG_ROUTES=False
